OPENAI_API_KEY=
# GapGPT example: https://api.gapgpt.app/v1
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Use `gapgpt` with the GapGPT URL above; it selects the OpenAI-compatible client.
LLM_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_REQUEST_TIMEOUT=120
JINA_API_KEY=
EMBEDDING_PROVIDER=jina
EMBEDDING_MODEL=jina-embeddings-v3
RERANKER_PROVIDER=jina
RERANKER_MODEL=jina-reranker-v2-base-multilingual
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_RERANKER_MODEL=pdurugyan/qwen3-reranker-0.6b-q8_0
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT=15
QDRANT_COLLECTION=bitteck_knowledge
SPARSE_MODEL=Qdrant/bm25
HYBRID_ALPHA=0.5
CACHE_ENABLED=true
CACHE_TTL_SECONDS=600
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVAL_TOP_K=8
RERANK_TOP_N=3
JOB_MAX_RETRIES=3
LOG_LEVEL=INFO
TESSERACT_CMD=tesseract
